// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemoriaType {

  GRAVIDEZ
  NASCIMENTO
  MARCO
  ANIVERSÁRIO
  FOTO
  CARTA
  OUTRO


}

model Memoria {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  happenedAt  DateTime
  imageUrl    String?
  type        MemoriaType @default(OUTRO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions MemoryReaction[]
  comments  MemoryComment[]
}

model GuestbookMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  email     String   @db.VarChar(254)
  message   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum VoteTeam {
  FILIPE
  MELINA
}

model Vote {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  team      VoteTeam
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MemoryReaction {
  id        Int     @id @default(autoincrement())
  memoriaId Int
  emoji     String  @db.VarChar(16)
  count     Int     @default(0)

  memoria Memoria @relation(fields: [memoriaId], references: [id], onDelete: Cascade)

  @@unique([memoriaId, emoji])
}

model MemoryComment {
  id        Int      @id @default(autoincrement())
  memoriaId Int
  name      String   @db.VarChar(80)
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  memoria Memoria @relation(fields: [memoriaId], references: [id], onDelete: Cascade)

  @@index([memoriaId, createdAt])
}

model Photo {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(120)
  imageUrl  String
  createdAt DateTime @default(now())

  reactions PhotoReaction[]
  comments  PhotoComment[]

  @@index([createdAt])
}

model PhotoReaction {
  id      Int    @id @default(autoincrement())
  photoId Int
  emoji   String @db.VarChar(16)
  count   Int    @default(0)

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, emoji])
}

model PhotoComment {
  id        Int      @id @default(autoincrement())
  photoId   Int
  name      String   @db.VarChar(80)
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
}
